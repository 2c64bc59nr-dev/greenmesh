<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: CRT black with the faint scan grid of a phosphor
  screen. Vector, so there is nothing raster to keep in sync.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#040705"
        android:pathData="M0,0 L108,0 L108,108 L0,108 z" />

    <!-- scan grid -->
    <path
        android:strokeColor="#0C1810"
        android:strokeWidth="1"
        android:pathData="M0,18 L108,18 M0,36 L108,36 M0,54 L108,54 M0,72 L108,72 M0,90 L108,90" />
    <path
        android:strokeColor="#0A140D"
        android:strokeWidth="1"
        android:pathData="M18,0 L18,108 M36,0 L36,108 M54,0 L54,108 M72,0 L72,108 M90,0 L90,108" />

    <!-- phosphor vignette -->
    <path
        android:fillColor="#0A1F12"
        android:pathData="M54,4 a50,50 0 1,0 0.1,0 z" />
</vector>
